# Vercel AI Gateway — preferred (works out-of-the-box on Vercel)
# Get one at https://vercel.com/dashboard/ai/gateway
AI_GATEWAY_API_KEY=

# Or use Anthropic directly (fallback if AI_GATEWAY_API_KEY isn't set)
ANTHROPIC_API_KEY=

# Stripe — leave blank in dev to enable demo "unlock without paying" flow
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Used for Stripe success/cancel URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
